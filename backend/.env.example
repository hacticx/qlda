PORT=3001
CORS_ORIGIN=http://localhost:5173
DB_FILE=./smarthr_m1.sqlite
UPLOAD_DIR=./uploads
MAX_CV_BYTES=10485760

# ========= AI Engine =========
# AI_MODE: mock | gemini | fail
#   mock   -> AI giả lập, chạy hoàn toàn offline (mặc định khi chưa có key)
#   gemini -> Gọi AI thật (cần AI_API_KEY và AI_BASE_URL đúng)
#   fail   -> Giả lập AI hỏng để demo luồng FALLBACK_MOCK
AI_MODE=mock

# ----- CÁCH 1: Gemini Developer API (KHUYÊN DÙNG để demo — Free Tier, không cần thẻ) -----
# Lấy key tại: https://aistudio.google.com/apikey (key dạng AIzaSy...)
#AI_API_KEY=AIzaSy...
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#AI_MODEL=gemini-flash-latest

# ----- CÁCH 2: Vertex AI Express Mode (cần bật Billing trên Google Cloud) -----
# Key dạng AQ.xxx (tạo tại console.cloud.google.com)
# Phải bật API tại: https://console.developers.google.com/apis/api/aiplatform.googleapis.com
#AI_API_KEY=AQ.xxx...
#AI_BASE_URL=https://aiplatform.googleapis.com/v1
#AI_MODEL=gemini-2.5-flash

# Timeout gọi AI (ms). PDF ~1-5MB thường mất 5-15s.
AI_TIMEOUT_MS=20000

# ========= Bảo mật nội bộ =========
# Khóa API nội bộ cho /api/internal/* (xem kết quả AI, chỉ dành cho HR)
INTERNAL_SERVICE_KEY=demo-hr-key
